{
  "name": "almax-football-predictions",
  "version": "1.1.7",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "preserve": "node scripts/write-version-file.js",
    "serve": "vue-cli-service serve",
    "dev": "npm run serve",
    "prebuild": "node scripts/write-version-file.js",
    "build": "vue-cli-service build",
    "deploy:cpanel": "bash scripts/publish_to_laravel_public.sh \"$LARAVEL_PUBLIC_DIR\"",
    "server": "node server/index.js",
    "dev:all": "npm run serve",
    "dev:legacy": "concurrently \"npm run serve\" \"npm run server\"",
    "db:migrate": "node server/migrate.js",
    "db:seed": "node server/seed.js",
    "db:import": "node server/migrateData.js",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/server/__tests__/**/*.test.js"
    ],
    "testTimeout": 15000
  },
  "dependencies": {
    "@uppy/core": "^6.3.0",
    "@uppy/dashboard": "^6.0.2",
    "@uppy/vue": "^4.0.1",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "core-js": "^3.8.3",
    "cors": "^2.8.5",
    "dotenv": "16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0",
    "pg-mem": "^3.0.14",
    "vue": "^3.2.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@babel/plugin-transform-private-methods": "^7.28.6",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "postcss": "^8.5.31",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
