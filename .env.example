# GitHub webhook secret (set same value in GitHub repo Settings → Webhooks)
WEBHOOK_SECRET=replace_with_random_secret

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/newbet

# JWT secret — use a random 64-character string
JWT_SECRET=replace_with_64_char_random_string

# Token expiry
JWT_EXPIRES_IN=12h

# Initial admin password (used once by db:seed — min 12 characters)
ADMIN_INITIAL_PASSWORD=replace_with_strong_password_12chars_min

# API key for live scores (optional)
SCORES_API_KEY=

# Football API key (api-football.com)
FOOTBALL_API_KEY=32d11afcf94ce079fb5a0e79a21948a2

# Allowed CORS origin for production
ALLOWED_ORIGIN=https://almaxpredictions.com

# Frontend API base URL used by the Vue app and admin client.
# Leave blank to use the current origin + Vue dev proxy, or set to your Laravel URL.
VUE_APP_API_URL=http://localhost:8000

# ─── Jpesa Mobile Money Payment API ──────────────────────────────────────────
# Get the API endpoint URL from your Jpesa merchant dashboard / support
JPESA_API_URL=https://my.jpesa.com/api/collect
# Your Jpesa API key
JPESA_API_KEY=79F36A45DE71FF4196A5C0920C5ECD7B
# Publicly accessible callback URL Jpesa will POST payment results to
JPESA_CALLBACK_URL=https://almaxpredictions.com/api/payments/webhook
# Optional: HMAC secret for validating Jpesa webhook callbacks
MOBILE_MONEY_WEBHOOK_SECRET=

# Developer commission dashboard
# Tracked only when a payment is confirmed. Historical confirmed payments without
# agent_commission_amount are intentionally not included in developer commission totals.
JPESA_AGENT_COMMISSION_ENABLED=true
JPESA_AGENT_COMMISSION_RATE=0.10
